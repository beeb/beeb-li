{
	"name": "beeb-li",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "biome lint src",
		"format": "biome format . --write && prettier --write src",
		"postbuild": "pagefind --site .vercel/output/static && rm -rf ./static/pagefind && cp -r ./.vercel/output/static/pagefind/ ./static/pagefind/"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@formatjs/intl-locale": "^5.4.0",
		"@iconify-json/lucide": "^1.2.149",
		"@iconify-json/mingcute": "^1.2.8",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/enhanced-img": "^1.0.0",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"asciinema-player": "^3.17.0",
		"daisyui": "^5.7.50",
		"hastscript": "^9.0.3",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-slug": "^6.0.0",
		"remark-abbr": "^1.4.2",
		"remark-toc": "^9.0.0",
		"satori": "^0.63.2",
		"shiki": "^4.5.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-preprocess": "^6.0.5",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.5",
		"vite-imagetools": "^12.0.1",
		"vite-plugin-arraybuffer": "^0.1.4",
		"vite-plugin-data-url": "^1.0.0"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@10.34.5"
}
